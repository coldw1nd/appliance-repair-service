<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.mirea.appliancerepair.fx.CustomerDialogController"
            stylesheets="@app.css" prefWidth="850.0" prefHeight="650.0" minWidth="700.0" minHeight="540.0">
    <top>
        <VBox spacing="5" styleClass="dialog-header">
            <padding><Insets top="20" right="24" bottom="16" left="24"/></padding>
            <Label text="Клиенты сервиса" styleClass="dialog-title" />
            <Label text="Заявка связывается с клиентом через список — вручную вводить ID не требуется." styleClass="subtitle" />
        </VBox>
    </top>
    <center>
        <VBox spacing="12" styleClass="content-area">
            <padding><Insets top="14" right="24" bottom="16" left="24"/></padding>
            <TableView fx:id="customerTable" VBox.vgrow="ALWAYS">
                <placeholder><Label text="Список клиентов пуст." /></placeholder>
                <columns>
                    <TableColumn fx:id="idColumn" text="№" prefWidth="55" />
                    <TableColumn fx:id="nameColumn" text="ФИО" prefWidth="190" />
                    <TableColumn fx:id="phoneColumn" text="Телефон" prefWidth="135" />
                    <TableColumn fx:id="emailColumn" text="Email" prefWidth="190" />
                    <TableColumn fx:id="addressColumn" text="Адрес" prefWidth="220" />
                </columns>
            </TableView>
            <Label text="Добавить клиента" styleClass="section-title" />
            <GridPane hgap="10" vgap="8">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" />
                    <ColumnConstraints percentWidth="50" />
                </columnConstraints>
                <TextField fx:id="nameField" promptText="ФИО клиента *" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <TextField fx:id="phoneField" promptText="Телефон *" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                <TextField fx:id="emailField" promptText="Email *" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <TextField fx:id="addressField" promptText="Адрес *" GridPane.rowIndex="1" GridPane.columnIndex="1" />
            </GridPane>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="dialog-actions">
            <padding><Insets top="0" right="24" bottom="20" left="24"/></padding>
            <Button text="Обновить список" onAction="#handleRefresh" />
            <Button text="Добавить клиента" onAction="#handleAdd" styleClass="button-primary" />
            <Button text="Закрыть" onAction="#handleClose" cancelButton="true" />
        </HBox>
    </bottom>
</BorderPane>
